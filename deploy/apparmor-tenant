#include <tunables/global>

profile bashgate.tenant /usr/local/bin/tenant-bash flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # 执行与库(ix 继承:子进程不逃出 profile)
  /usr/bin/* ix,
  /bin/* ix,
  /usr/sbin/* ix,
  /usr/local/bin/* ix,
  /usr/** mr,
  /lib/** mr,
  /usr/share/** r,
  /etc/alternatives/** r,

  # 观察期从宽(先跑通再看 log 收紧)
  /etc/** r,
  /proc/** r,
  /sys/** r,
  /tmp/** rw,
  /var/tmp/** rw,
  /dev/null rw,
  /dev/zero r,
  /dev/full rw,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/pts/** rw,

  /home/** rwk,
  /workspace/** rwk,

  # 租户共享区与假文件墙源
  /data/ r,
  /data/share/** r,
  /srv/proc-mask/** rw,

  # 显式拒绝(DAC 之外的策略层;bind mount 视角待 complain 日志确认后精调)
  audit deny /data/userB/** rwklx,
  audit deny /software/** rwklx,
  audit deny /root/** rwklx,
  audit deny /etc/shadow* rwklx,
  audit deny /var/log/** rwklx,

}
